# Contact form endpoint. Choose ONE provider and fill its URL.
# Option A — Web3Forms: https://web3forms.com/ (get an access key, then use the form endpoint)
# VITE_CONTACT_ENDPOINT=https://api.web3forms.com/submit
# VITE_CONTACT_ACCESS_KEY=your_web3forms_access_key

# Option B — Formspree: https://formspree.io/ (use your form ID)
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/your_form_id

# Optional: recipient used by the mailto: fallback when no endpoint is configured.
VITE_CONTACT_EMAIL=mahipriyadarshi0@gmail.com

